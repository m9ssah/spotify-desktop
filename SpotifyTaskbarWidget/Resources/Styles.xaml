<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══ Font ═══════════════════════════════════════════════════════ -->
    <!-- Windows 11 system font: Segoe UI Variable, fallback to Segoe UI -->
    <FontFamily x:Key="WidgetFontFamily">Segoe UI Variable, Segoe UI, Segoe UI Semibold</FontFamily>

    <!-- ═══ Dynamic Theme Colors (set at runtime by ThemeService) ══════ -->
    <!-- These are default dark mode values; ThemeService overrides them -->
    <SolidColorBrush x:Key="WidgetForeground" Color="White" />
    <SolidColorBrush x:Key="WidgetSecondaryForeground" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="WidgetHoverBackground" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="WidgetBackground" Color="Transparent" />
    <SolidColorBrush x:Key="WidgetAccentColor" Color="#1DB954" />

    <!-- ═══ Control Button Style ═══════════════════════════════════════ -->
    <!-- Transparent button with subtle hover highlight, matches Windows 11 -->
    <Style x:Key="ControlButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource WidgetForeground}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background"
                                    Value="{DynamicResource WidgetHoverBackground}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background"
                                    Value="#55FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Play/Pause Button Style (slightly larger) ══════════════════ -->
    <Style x:Key="PlayPauseButtonStyle" TargetType="Button" BasedOn="{StaticResource ControlButtonStyle}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="5" />
    </Style>

    <!-- ═══ Album Art Style ════════════════════════════════════════════ -->
    <Style x:Key="AlbumArtStyle" TargetType="Border">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <!-- ═══ Track Name Style ═══════════════════════════════════════════ -->
    <Style x:Key="TrackNameStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource WidgetFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource WidgetForeground}" />
        <Setter Property="TextTrimming" Value="None" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!-- ═══ Artist Name Style ══════════════════════════════════════════ -->
    <Style x:Key="ArtistNameStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource WidgetFontFamily}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{DynamicResource WidgetSecondaryForeground}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!-- ═══ Spotify Icon Placeholder (when no album art) ═══════════════ -->
    <Style x:Key="SpotifyPlaceholderStyle" TargetType="Border">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="#282828" />
    </Style>

</ResourceDictionary>
