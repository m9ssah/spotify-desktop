<Window x:Class="SpotifyTaskbarWidget.Views.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect to Spotify"
        Width="420" Height="320"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="#191414">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Spotify Logo / Title -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center">
            <Viewbox Width="48" Height="48" Margin="0,0,0,12">
                <Path Data="M 12,2 C 6.48,2 2,6.48 2,12 C 2,17.52 6.48,22 12,22 C 17.52,22 22,17.52 22,12 C 22,6.48 17.52,2 12,2 Z M 16.43,16.57 C 16.24,16.84 15.87,16.92 15.6,16.74 C 13.14,15.24 10.08,14.88 6.31,15.72 C 5.99,15.8 5.67,15.6 5.59,15.28 C 5.51,14.96 5.71,14.64 6.03,14.56 C 10.15,13.64 13.55,14.04 16.29,15.72 C 16.56,15.9 16.64,16.27 16.43,16.57 Z M 17.73,13.84 C 17.5,14.18 17.05,14.28 16.72,14.06 C 13.91,12.32 9.69,11.82 6.21,12.88 C 5.84,12.99 5.44,12.78 5.33,12.41 C 5.22,12.04 5.43,11.64 5.8,11.53 C 9.73,10.33 14.37,10.89 17.55,12.86 C 17.88,13.08 17.98,13.53 17.73,13.84 Z M 17.84,11.01 C 14.49,9.02 8.89,8.8 5.58,9.79 C 5.13,9.93 4.65,9.67 4.51,9.22 C 4.37,8.77 4.63,8.29 5.08,8.15 C 8.87,7.02 15.04,7.27 18.86,9.55 C 19.27,9.8 19.39,10.33 19.14,10.74 C 18.89,11.15 18.36,11.27 17.95,11.02 Z"
                      Fill="#1DB954" />
            </Viewbox>
            <TextBlock Text="Spotify Taskbar Widget"
                       FontFamily="Segoe UI Variable, Segoe UI"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="White"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Description -->
        <TextBlock Grid.Row="2"
                   Text="Connect your Spotify account to display playback controls in your taskbar."
                   FontFamily="Segoe UI Variable, Segoe UI"
                   FontSize="13"
                   Foreground="#B3FFFFFF"
                   TextWrapping="Wrap"
                   TextAlignment="Center" />

        <!-- Connect Button -->
        <Button Grid.Row="4"
                x:Name="ConnectButton"
                Click="OnConnectClick"
                Height="44"
                Cursor="Hand"
                FontFamily="Segoe UI Variable, Segoe UI"
                FontSize="15"
                FontWeight="SemiBold"
                Foreground="White">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="#1DB954"
                            CornerRadius="22"
                            Padding="32,0">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="#1ED760" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="#18A34A" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="#535353" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <TextBlock x:Name="ConnectButtonText" Text="Connect to Spotify" />
        </Button>

        <!-- Status Text -->
        <TextBlock Grid.Row="6"
                   x:Name="StatusText"
                   Text=""
                   FontFamily="Segoe UI Variable, Segoe UI"
                   FontSize="11"
                   Foreground="#80FFFFFF"
                   TextAlignment="Center"
                   TextWrapping="Wrap" />
    </Grid>
</Window>
