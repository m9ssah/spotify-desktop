<UserControl x:Class="SpotifyTaskbarWidget.Views.TaskbarWidgetControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:SpotifyTaskbarWidget.Converters"
             Background="Transparent"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:BoolToOpacityConverter x:Key="BoolToOpacity" />
    </UserControl.Resources>

    <!-- ═══ Main Layout ════════════════════════════════════════════════ -->
    <!-- 3-column grid: Album Art | Track Info | Playback Controls       -->
    <Grid x:Name="RootGrid"
          Opacity="{Binding IsPlaying, Converter={StaticResource BoolToOpacity}}"
          Margin="4,0">

        <Grid.ColumnDefinitions>
            <!-- Album Art -->
            <ColumnDefinition Width="Auto" />
            <!-- Spacing -->
            <ColumnDefinition Width="8" />
            <!-- Track Info (flexible) -->
            <ColumnDefinition Width="*" MinWidth="80" MaxWidth="180" />
            <!-- Spacing -->
            <ColumnDefinition Width="4" />
            <!-- Playback Controls -->
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- ─── Album Art ──────────────────────────────────────────── -->
        <Grid Grid.Column="0" VerticalAlignment="Center">
            <!-- Placeholder (no album art) -->
            <Border Style="{StaticResource SpotifyPlaceholderStyle}"
                    Visibility="{Binding HasTrack, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                <!-- Spotify-like music note icon -->
                <Viewbox Margin="8">
                    <Path Data="M 12,3 L 12,12.27 C 11.5,12.1 10.97,12 10.4,12 C 8.52,12 7,13.12 7,14.5 C 7,15.88 8.52,17 10.4,17 C 12.28,17 13.8,15.88 13.8,14.5 L 13.8,6 L 18,6 L 18,3 Z"
                          Fill="{DynamicResource WidgetSecondaryForeground}" />
                </Viewbox>
            </Border>

            <!-- Album Art Image -->
            <Border Style="{StaticResource AlbumArtStyle}"
                    Visibility="{Binding HasTrack, Converter={StaticResource BoolToVisibility}}">
                <Image Source="{Binding AlbumArt}"
                       Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>
        </Grid>

        <!-- ─── Track Info ─────────────────────────────────────────── -->
        <Grid Grid.Column="2" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Track Name with Marquee Scroll -->
            <Canvas Grid.Row="0" Height="16" ClipToBounds="True">
                <TextBlock x:Name="TrackNameText"
                           Style="{StaticResource TrackNameStyle}"
                           Text="{Binding TrackName}"
                           Canvas.Top="0">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="TrackNameTranslate" X="0" />
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Canvas>

            <!-- Artist Name -->
            <TextBlock Grid.Row="2"
                       Style="{StaticResource ArtistNameStyle}"
                       Text="{Binding ArtistName}" />
        </Grid>

        <!-- ─── Playback Controls ──────────────────────────────────── -->
        <StackPanel Grid.Column="4"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="0">

            <!-- Previous Track -->
            <Button Style="{StaticResource ControlButtonStyle}"
                    Command="{Binding PreviousTrackCommand}"
                    ToolTip="Previous">
                <Viewbox>
                    <Path Data="M 3,2 L 3,14 L 5,14 L 5,2 Z M 5,8 L 15,2 L 15,14 Z"
                          Fill="{DynamicResource WidgetForeground}" />
                </Viewbox>
            </Button>

            <!-- Play / Pause -->
            <Button Style="{StaticResource PlayPauseButtonStyle}"
                    Command="{Binding PlayPauseCommand}"
                    ToolTip="Play/Pause">
                <Viewbox>
                    <Path Data="{Binding PlayPauseIcon}"
                          Fill="{DynamicResource WidgetForeground}" />
                </Viewbox>
            </Button>

            <!-- Next Track -->
            <Button Style="{StaticResource ControlButtonStyle}"
                    Command="{Binding NextTrackCommand}"
                    ToolTip="Next">
                <Viewbox>
                    <Path Data="M 3,2 L 3,14 L 13,8 Z M 13,2 L 13,14 L 15,14 L 15,2 Z"
                          Fill="{DynamicResource WidgetForeground}" />
                </Viewbox>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
